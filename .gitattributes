# Normalise to LF in the repo. Without this, a Windows clone with
# core.autocrlf=true rewrites deploy/setup.sh with CRLF endings and it dies on
# the VM with "bad interpreter: /usr/bin/env bash^M".
* text=auto eol=lf

# Except the Windows launcher, which needs CRLF to work in cmd.exe.
*.bat text eol=crlf

# Never touch these.
*.png binary
*.jpg binary
*.ico binary
